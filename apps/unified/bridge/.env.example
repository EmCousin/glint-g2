HOST=127.0.0.1
PORT=8786
BRIDGE_TOKEN=replace-with-a-long-random-token

# Comma-separated list of providers to load (default: all three)
# PROVIDERS=signal,whatsapp,hey

# Signal provider
SIGNAL_PROVIDER=mock
# GURK_CONFIG=/home/you/.config/gurk/gurk.toml
# GURK_DATA_DIR=/home/you/.local/share/gurk
# GURK_PASSPHRASE=
# SQLCIPHER_PATH=/usr/bin/sqlcipher
# SIGNAL_SOCKET=/run/user/1000/signal-cli/socket
# SIGNAL_ACCOUNT=+15551234567

# WhatsApp provider
MESSAGING_PROVIDER=mock
# WHATSAPP_AUTH_DIR=data/whatsapp-auth
# WHATSAPP_STORE=data/whatsapp-store.json
# WHATSAPP_PHONE_NUMBER=15551234567
# WHATSAPP_LOG_LEVEL=warn

# HEY provider
HEY_PROVIDER=mock
# HEY_ACCOUNT=work
# HEY_BOX=imbox
# HEY_PATH=/usr/local/bin/hey

# Voice transcription (shared across all providers)
# WHISPER_PYTHON=.venv/bin/python
# WHISPER_MODEL=base
# WHISPER_LANGUAGE=
